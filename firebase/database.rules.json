{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'uid', 'pub', 'xpub'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "about": {
          ".validate": "newData.isString() && newData.val().length <= 280"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 40000"
        },
        "tick": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        }
      }
    },
    "mailbox": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$msg": {
          ".write": "auth != null && ((!data.exists() && newData.child('f').val() === auth.uid) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['f', 'e', 'n', 'c', 't']) && newData.child('c').isString() && newData.child('c').val().length < 2200000 && newData.child('t').val() <= now"
        }
      }
    },
    "official": {
      ".read": "auth != null",
      ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : root.child('users').child(auth.uid).child('username').val() === 'bluecenchchat')",
      ".validate": "newData.hasChildren(['owner','key'])",
      "owner": {
        ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === auth.uid"
      },
      "key": {
        ".validate": "newData.isString() && newData.val().length === 44 && (!data.exists() || data.val() === newData.val())"
      },
      "ticks": {
        "$uid": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        }
      },
      "rev": {
        "$uid": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        }
      },
      "$x": {
        ".validate": false
      }
    },
    "calls": {
      "$cid": {
        ".read": "auth != null",
        "$from": {
          ".write": "auth != null && auth.uid === $from",
          "$frame": {
            ".validate": "newData.isString() && newData.val().length <= 12000"
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}